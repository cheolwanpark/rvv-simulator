#!/usr/bin/env bash
set -euo pipefail

usage() {
    cat <<'USAGE'
usage:
  saturn-run [options] [-- simulator-args...]

workloads:
  vec-daxpy       bundled RV64 vector DAXPY (default)
  vec-strlen      bundled RV64 vector strlen
  PATH            custom RV64 bare-metal ELF

options:
  --workload NAME|PATH
  --max-cycles N
  --seed N
  --wave
  --wave-path PATH
  --list
  --dry-run
  -h, --help
USAGE
}

die() {
    echo "saturn-run: $*" >&2
    exit 2
}

require_positive_integer() {
    case "$2" in
        ''|*[!0-9]*|0) die "$1 needs a positive integer" ;;
    esac
}

saturn_home=${SATURN_HOME:-/workspace/Chipyard}
normal_sim=${SATURN_SIM:-/opt/saturn-rtl/bin/saturn-sim}
trace_sim=${SATURN_TRACE_SIM:-/opt/saturn-rtl/bin/saturn-sim-trace}
workloads_dir=${SATURN_WORKLOADS:-/opt/saturn-rtl/workloads}

workload=vec-daxpy
max_cycles=10000000
seed=
wave=0
wave_path=./saturn.fst
dry_run=0
raw_args=()

resolve_workload() {
    case "$1" in
        vec-daxpy) printf '%s\n' "$workloads_dir/vec-daxpy.riscv" ;;
        vec-strlen) printf '%s\n' "$workloads_dir/vec-strlen.riscv" ;;
        *) printf '%s\n' "$1" ;;
    esac
}

print_list() {
    cat <<EOF
workloads:
  vec-daxpy       $workloads_dir/vec-daxpy.riscv
  vec-strlen      $workloads_dir/vec-strlen.riscv
EOF
}

while [ "$#" -gt 0 ]; do
    case "$1" in
        --workload)
            [ "$#" -ge 2 ] || die "--workload needs value"
            workload=$2
            shift 2
            ;;
        --max-cycles)
            [ "$#" -ge 2 ] || die "--max-cycles needs value"
            require_positive_integer --max-cycles "$2"
            max_cycles=$2
            shift 2
            ;;
        --seed)
            [ "$#" -ge 2 ] || die "--seed needs value"
            require_positive_integer --seed "$2"
            seed=$2
            shift 2
            ;;
        --wave)
            wave=1
            shift
            ;;
        --wave-path)
            [ "$#" -ge 2 ] || die "--wave-path needs value"
            wave=1
            wave_path=$2
            shift 2
            ;;
        --list)
            print_list
            exit 0
            ;;
        --dry-run)
            dry_run=1
            shift
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        --)
            shift
            raw_args+=("$@")
            break
            ;;
        *)
            die "unknown option: $1"
            ;;
    esac
done

workload_path=$(resolve_workload "$workload")
[ -f "$workload_path" ] || die "workload not found: $workload_path"

elf_description=$(file -b "$workload_path")
case "$elf_description" in
    *"ELF 64-bit"*) ;;
    *) die "workload must be an ELF64 file: $workload_path" ;;
esac
case "$elf_description" in
    *"RISC-V"*) ;;
    *) die "workload must target RISC-V: $workload_path" ;;
esac

sim=$normal_sim
if [ "$wave" = 1 ]; then
    sim=$trace_sim
    wave_dir=$(dirname "$wave_path")
    [ -d "$wave_dir" ] || die "wave output directory not found: $wave_dir"
    [ -w "$wave_dir" ] || die "wave output directory not writable: $wave_dir"
fi
[ -x "$sim" ] || die "simulator not executable: $sim"

cmd=(
    "$sim"
    +permissive
    +dramsim
    "+dramsim_ini_dir=$saturn_home/generators/testchipip/src/main/resources/dramsim2_ini"
    "+max-cycles=$max_cycles"
)

if [ -n "$seed" ]; then
    cmd+=("+verilator+seed+$seed")
fi
if [ "$wave" = 1 ]; then
    cmd+=("+vcdfile=$wave_path")
fi

cmd+=(+permissive-off "$workload_path")
if [ "${#raw_args[@]}" -gt 0 ]; then
    cmd+=("${raw_args[@]}")
fi

if [ "$dry_run" = 1 ]; then
    printf '%q ' "${cmd[@]}"
    printf '\n'
    exit 0
fi

exec "${cmd[@]}"
